"Bluetooth-Adapter."
msgstr ""

#: tretlager/kde/qml/SensorsPage.qml:211
msgid "Verbindung bricht oft ab"
msgstr ""

#: tretlager/kde/qml/SensorsPage.qml:212
msgid ""
"Bluetooth reicht schlecht durch Wände. Rechner näher an den Trainer stellen "
"oder einen USB-Bluetooth-Stick mit Verlängerung neben den Trainer legen."
msgstr ""

