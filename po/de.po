msgid "Bluetooth is off or the adapter is missing"
msgstr "Bluetooth ist aus oder der Adapter fehlt"

#: tretlager/bridge/device.py:223
msgid "Bluetooth is busy, retrying"
msgstr "Bluetooth ist gerade beschäftigt, neuer Versuch folgt"

#: tretlager/bridge/device.py:225
msgid "Connection attempt aborted, retrying"
msgstr "Verbindungsaufbau abgebrochen, neuer Versuch folgt"

#: tretlager/bridge/device.py:227
msgid "Bluetooth denies access to the device"
msgstr "Bluetooth verweigert den Zugriff auf das Gerät"

#: tretlager/bridge/device.py:230
msgid "Connection failed, retrying"
msgstr "Verbindung fehlgeschlagen, neuer Versuch folgt"

#: tretlager/bridge/device.py:372
msgid ""
"Bluetooth keeps a slow setting for this sensor – unplug and plug in the "
"Bluetooth adapter, or restart the computer"
msgstr ""
"Bluetooth hält für diesen Sensor eine langsame Einstellung fest – Bluetooth-"
"Stick ab- und wieder anstecken oder den Rechner neu starten"

#: tretlager/bridge/device.py:424
msgid ""
"Device offers no supported service (FTMS, Cycling Power, CSC, heart rate)"
msgstr ""
"Gerät bietet keinen unterstützten Dienst (FTMS, Cycling Power, CSC, "
"Herzfrequenz)"

#: tretlager/bridge/device.py:446
msgid "Connection to the device lost"
msgstr "Verbindung zum Gerät verloren"

#: tretlager/bridge/device.py:508
msgid "Device not connected"
msgstr "Gerät nicht verbunden"

#: tretlager/core/bridgectl.py:47
