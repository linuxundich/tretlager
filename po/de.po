#: tretlager/core/login.py:62
msgid "The sign-in was cancelled."
msgstr "Die Anmeldung wurde abgebrochen."

#: tretlager/core/login.py:63 tretlager/core/login.py:64
msgid ""
"Zwift requires signing in with email and password. Please sign in again."
msgstr ""
"Zwift verlangt eine Anmeldung mit E-Mail und Passwort. Bitte erneut anmelden."

#: tretlager/core/login.py:65
msgid "Zwift sign-in is unavailable right now. Please try again later."
msgstr ""
"Die Zwift-Anmeldung ist gerade nicht erreichbar. Bitte später erneut "
"versuchen."

#: tretlager/core/login.py:66
msgid "Zwift sign-in reported an error. Please try again later."
msgstr ""
"Bei der Zwift-Anmeldung ist ein Fehler aufgetreten. Bitte später erneut "
"versuchen."

#: tretlager/core/login.py:71
#, python-brace-format
msgid ""
"Zwift did not complete the sign-in (error “{code}”). Please sign in again."
msgstr ""
"Zwift hat die Anmeldung nicht abgeschlossen (Fehler „{code}“). Bitte erneut "
"anmelden."

#: tretlager/core/login.py:79
msgid ""
"This is not the address shown after signing in to Zwift (launcher.zwift.com/"
"launcher?…)."
msgstr ""
"Das ist nicht die Adresse nach der Zwift-Anmeldung (launcher.zwift.com/"
"launcher?…)."

#: tretlager/core/login.py:85
msgid "The address is missing the sign-in code (code=…)."
msgstr "In der Adresse fehlt der Anmeldecode (code=…)."

#: tretlager/core/login.py:87
msgid ""
"The address belongs to an earlier sign-in. Please sign in again in the "
"browser."
msgstr ""
"Die Adresse gehört zu einer älteren Anmeldung. Bitte erneut im Browser "
"anmelden."

#: tretlager/core/login.py:99
msgid "Zwift rejected the sign-in (code expired or already used)."
msgstr ""
"Zwift hat die Anmeldung abgelehnt (Code abgelaufen oder bereits benutzt)."

#: tretlager/core/login.py:100
#, python-brace-format
msgid "Zwift sign-in unreachable (HTTP {code})."
msgstr "Zwift-Anmeldung nicht erreichbar (HTTP {code})."

#: tretlager/core/login.py:102
msgid "Zwift sign-in unreachable. Is there an internet connection?"
msgstr "Zwift-Anmeldung nicht erreichbar. Besteht eine Internetverbindung?"

#: tretlager/core/login.py:104
msgid "Unexpected response from Zwift."
msgstr "Unerwartete Antwort von Zwift."

#: tretlager/core/login.py:127
#, python-brace-format
msgid "Signing out of Zwift failed (HTTP {code})."
msgstr "Abmelden bei Zwift fehlgeschlagen (HTTP {code})."

#: tretlager/core/login.py:129
msgid "Zwift sign-in unreachable; signed out locally."
msgstr "Zwift-Anmeldung nicht erreichbar; lokal abgemeldet."

#: tretlager/core/login.py:161
msgid ""
"python3-secretstorage is missing; without a keyring Tretlager does not store "
"a token."
msgstr ""
"python3-secretstorage fehlt; ohne Schlüsselbund speichert Tretlager kein "
"Token."

#: tretlager/core/login.py:168
msgid "The keyring is locked. Unlock the keyring to start Zwift."
msgstr ""
"Der Schlüsselbund ist gesperrt. Zum Starten von Zwift den Schlüsselbund "
"entsperren."

#: tretlager/core/login.py:171
msgid ""
"No keyring available. Tretlager keeps the Zwift session in the desktop "
"keyring (KWallet or GNOME Keyring), which must be running and unlocked."
msgstr ""
"Kein Schlüsselbund erreichbar. Tretlager speichert die Zwift-Sitzung im "
"Schlüsselbund des Desktops (KWallet bzw. GNOME Schlüsselbund); dieser muss "
"laufen und entsperrt sein."

