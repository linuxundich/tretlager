#: tretlager/bridge/device.py:170 tretlager/bridge/device.py:175
#: tretlager/bridge/device.py:194
msgid "Bluetooth is stuck – switch Bluetooth off and on again"
msgstr "Bluetooth hängt – Bluetooth kurz aus- und wieder einschalten"

#: tretlager/bridge/device.py:187
msgid ""
"Another Bluetooth device such as headphones is using the adapter – "
"disconnect it or connect it through another adapter"
msgstr ""
"Ein anderes Bluetooth-Gerät wie Kopfhörer belegt den Adapter – trennen oder "
"über einen anderen Adapter verbinden"

#: tretlager/bridge/device.py:214
msgid "Out of range or asleep"
msgstr "Nicht in Reichweite oder schläft"

#: tretlager/bridge/device.py:217
msgid "Device is asleep – pedal briefly or put on the strap"
msgstr "Gerät schläft – kurz treten bzw. Gurt anlegen"

