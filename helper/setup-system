#!/usr/bin/python3 -I
"""Tretlager: Systemvorbereitung als root (über pkexec, Polkit-Aktion de.linuxundich.tretlager.setup).

Bewusst ohne freie Parameter: Das einzige Kommando ist `install`. Es
  1. prüft den mitgelieferten WineHQ-Schlüssel gegen den festen Fingerabdruck,
  2. legt Schlüssel und Paketquelle (nur amd64) an,
  3. aktualisiert die Paketlisten und installiert die feste Paketliste,
     ohne etwas zu entfernen (--no-remove) und ohne Systemupgrade.
Ausgabe: eine JSON-Zeile pro Ereignis (step, progress, log, done, error).
Konstanten müssen zu tretlager/core/prepare.py passen (Test test_helper_constants).
"""

import json
import os
import subprocess
import sys

WINEHQ_FPR = "D43F640145369C51D786DDEA76F1A20FF987672F"
WINEHQ_URI = "https://dl.winehq.org/wine-builds/debian"
WINEHQ_SUITE = "forky"
PACKAGES = ["winehq-devel", "cabextract", "osslsigncode"]

KEY_SRC = "/usr/share/tretlager/winehq.key"
KEY_DST = "/etc/apt/keyrings/winehq-archive.key"
SOURCES_DST = "/etc/apt/sources.list.d/winehq-forky.sources"


def emit(event, **kw):
    print(json.dumps({"event": event, **kw}, ensure_ascii=False), flush=True)


def fail(text):
    emit("error", text=text)
    sys.exit(1)


def fingerprint(path):
    r = subprocess.run(["gpg", "--batch", "--show-keys", "--with-colons", path],
                       capture_output=True, text=True, env={"PATH": "/usr/bin:/bin", "GNUPGHOME": "/nonexistent"})
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if parts[0] == "fpr":
            return parts[9]
    return ""


def write_file(path, data, mode=0o644):
    tmp = path + ".tretlager-tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def apt(args, step_text, base, span):
    """apt-get mit Status-Fd: pmstatus/dlstatus werden zu progress-Ereignissen (base … base+span %)."""
    emit("step", text=step_text)
    r, w = os.pipe()
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "DEBIAN_FRONTEND": "noninteractive",
           "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8"}
    proc = subprocess.Popen(["apt-get", "-q", "-o", f"APT::Status-Fd={w}", *args],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            pass_fds=(w,), env=env)
    os.close(w)
    status = os.fdopen(r)
    import selectors
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ, "out")
    sel.register(status, selectors.EVENT_READ, "status")
    open_streams = 2
    while open_streams:
        for key, _ in sel.select():
            line = key.fileobj.readline()
            if not line:
                sel.unregister(key.fileobj)
                open_streams -= 1
                continue
            line = line.rstrip("\n")
            if key.data == "out":
                emit("log", text=line)
            else:
                parts = line.split(":", 3)
                if len(parts) == 4 and parts[0] in ("pmstatus", "dlstatus"):
                    try:
                        pct = float(parts[2])
                    except ValueError:
                        continue
                    emit("progress", percent=round(base + span * pct / 100, 1), text=parts[3])
    rc = proc.wait()
    if rc != 0:
        fail(f"apt-get {' '.join(args[:2])} ist fehlgeschlagen (Code {rc}), Details im Protokoll")


def main():
    if len(sys.argv) != 2 or sys.argv[1] != "install":
        fail("Aufruf: setup-system install")
    if os.geteuid() != 0:
        fail("Muss als root laufen (über pkexec)")

    emit("step", text="WineHQ-Schlüssel prüfen")
    if fingerprint(KEY_SRC) != WINEHQ_FPR:
        fail("WineHQ-Schlüssel stimmt nicht mit dem erwarteten Fingerabdruck überein")
    with open(KEY_SRC, "rb") as f:
        key = f.read()
    os.makedirs(os.path.dirname(KEY_DST), mode=0o755, exist_ok=True)
    write_file(KEY_DST, key)

    emit("step", text="Paketquelle einrichten")
    write_file(SOURCES_DST, (f"Types: deb\nURIs: {WINEHQ_URI}\nSuites: {WINEHQ_SUITE}\nComponents: main\n"
                             f"Architectures: amd64\nSigned-By: {KEY_DST}\n").encode())
    emit("progress", percent=5, text="Paketquelle eingerichtet")

    apt(["update"], "Paketlisten aktualisieren", 5, 15)
    apt(["install", "-y", "--install-recommends", "--no-remove", *PACKAGES],
        "Wine und Werkzeuge installieren", 20, 80)

    r = subprocess.run(["wine", "--version"], capture_output=True, text=True,
                       env={"PATH": "/usr/bin:/bin", "HOME": "/nonexistent"})
    emit("done", text="System vorbereitet", wine=r.stdout.strip())


if __name__ == "__main__":
    main()
