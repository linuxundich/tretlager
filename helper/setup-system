#!/usr/bin/python3 -I
"""Tretlager: system preparation as root (via pkexec, polkit action de.linuxundich.tretlager.setup).

Deliberately without free parameters: the only command is `install`. It
  1. checks the bundled WineHQ key against the fixed fingerprint,
  2. installs the key and the package source (amd64 only),
  3. updates the package lists and installs the fixed package list,
     without removing anything (--no-remove) and without a system upgrade.
Output: one JSON line per event (step, progress, log, done, error).
Constants must match tretlager/core/prepare.py (test test_helper_constants).
"""

import json
import os
import subprocess
import sys
import tempfile

WINEHQ_FPR = "D43F640145369C51D786DDEA76F1A20FF987672F"
WINEHQ_BASE = "https://dl.winehq.org/wine-builds"
WINEHQ_URI = WINEHQ_BASE + "/debian"
WINEHQ_SUITE = "forky"
PACKAGES = ["winehq-devel", "cabextract", "osslsigncode"]


def winehq_repo(os_release: str = "/etc/os-release") -> tuple[str, str]:
    """(URI, suite) of the WineHQ repository for this system: Ubuntu gets its own builds (the Debian
    ones need newer libraries such as libavcodec63), everything else the Debian forky builds."""
    try:
        osr = dict(l.strip().split("=", 1) for l in open(os_release) if "=" in l)
    except OSError:
        osr = {}
    osr = {k: v.strip('"') for k, v in osr.items()}
    if osr.get("ID") == "ubuntu" and osr.get("VERSION_CODENAME"):
        return WINEHQ_BASE + "/ubuntu", osr["VERSION_CODENAME"]
    return WINEHQ_URI, WINEHQ_SUITE

KEY_SRC = "/usr/share/tretlager/winehq.key"
KEY_DST = "/etc/apt/keyrings/winehq-archive.asc"
SOURCES_DST = "/etc/apt/sources.list.d/winehq.sources"


def N_(text):
    """Marker for translation only; Tretlager translates the texts when displaying them (root
    does not have the user's language)."""
    return text


def emit(event, **kw):
    print(json.dumps({"event": event, **kw}, ensure_ascii=False), flush=True)


def fail(text):
    emit("error", text=text)
    sys.exit(1)


def fingerprint(path):
    # Own empty GnuPG directory: create nothing under /root; a non-existent directory, on the
    # other hand, makes gpg abort.
    with tempfile.TemporaryDirectory(prefix="tretlager-gpg-") as home:
        r = subprocess.run(["gpg", "--batch", "--show-keys", "--with-colons", path],
                           capture_output=True, text=True, env={"PATH": "/usr/bin:/bin", "GNUPGHOME": home})
    for line in r.stdout.splitlines():
        parts = line.split(":")
        if parts[0] == "fpr":
            return parts[9]
    return ""


def write_file(path, data, mode=0o644):
    tmp = path + ".tretlager-tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def apt(args, step_text, base, span):
    """apt-get with a status fd: pmstatus/dlstatus become progress events (base … base+span %)."""
    emit("step", text=step_text)
    r, w = os.pipe()
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "DEBIAN_FRONTEND": "noninteractive",
           "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8"}
    proc = subprocess.Popen(["apt-get", "-q", "-o", f"APT::Status-Fd={w}", *args],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            pass_fds=(w,), env=env)
    os.close(w)
    status = os.fdopen(r)
    import selectors
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ, "out")
    sel.register(status, selectors.EVENT_READ, "status")
    open_streams = 2
    while open_streams:
        for key, _ in sel.select():
            line = key.fileobj.readline()
            if not line:
                sel.unregister(key.fileobj)
                open_streams -= 1
                continue
            line = line.rstrip("\n")
            if key.data == "out":
                emit("log", text=line)
            else:
                parts = line.split(":", 3)
                if len(parts) == 4 and parts[0] in ("pmstatus", "dlstatus"):
                    try:
                        pct = float(parts[2])
                    except ValueError:
                        continue
                    emit("progress", percent=round(base + span * pct / 100, 1), text=parts[3])
    rc = proc.wait()
    if rc != 0:
        fail(f"apt-get {' '.join(args[:2])} failed (code {rc}), details in the log")


def main():
    if len(sys.argv) != 2 or sys.argv[1] != "install":
        fail("Usage: setup-system install")
    if os.geteuid() != 0:
        fail("Must run as root (via pkexec)")

    emit("step", text=N_("Checking the WineHQ key"))
    if fingerprint(KEY_SRC) != WINEHQ_FPR:
        fail(N_("The WineHQ key does not match the expected fingerprint"))
    with open(KEY_SRC, "rb") as f:
        key = f.read()
    os.makedirs(os.path.dirname(KEY_DST), mode=0o755, exist_ok=True)
    write_file(KEY_DST, key)

    emit("step", text=N_("Setting up the package source"))
    uri, suite = winehq_repo()
    write_file(SOURCES_DST, (f"Types: deb\nURIs: {uri}\nSuites: {suite}\nComponents: main\n"
                             f"Architectures: amd64\nSigned-By: {KEY_DST}\n").encode())
    emit("progress", percent=5, text=N_("Package source set up"))

    apt(["update"], N_("Updating package lists"), 5, 15)
    apt(["install", "-y", "--install-recommends", "--no-remove", *PACKAGES],
        N_("Installing Wine and tools"), 20, 80)

    r = subprocess.run(["wine", "--version"], capture_output=True, text=True,
                       env={"PATH": "/usr/bin:/bin", "HOME": "/nonexistent"})
    emit("done", text=N_("System prepared"), wine=r.stdout.strip())


if __name__ == "__main__":
    main()
