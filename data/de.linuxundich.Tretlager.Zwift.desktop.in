[Desktop Entry]
Type=Application
Name=Zwift (Tretlager)
Comment=Start Zwift with the sensor bridge
Comment[de]=Zwift mit Sensor-Bridge starten
Exec=env PYTHONPATH=@LIBDIR@ /usr/bin/python3 -m tretlager.kde --start
Icon=de.linuxundich.Tretlager
Categories=Game;Sports;
Keywords=Zwift;Cycling;Training;
Keywords[de]=Zwift;Rad;Training;
StartupNotify=true
